__pycache__/
*.pyc
.env
.claude/settings.local.json
.claude/settings.json

# Artefatos de teste
.pytest_cache/
.hypothesis/

# ==== Dados de runtime — TUDO sob dados/ (reorg de estrutura 2026-07) ====
# Modelos de IA (binários grandes) — versiona só a estrutura de pastas
dados/modelos/*
!dados/modelos/.gitkeep
!dados/modelos/README.md
!dados/modelos/whisper/
dados/modelos/whisper/*
!dados/modelos/whisper/.gitkeep

# Vault Obsidian local (notas do usuário, não versionadas)
dados/Cerebro_Digital/
# Notas TIRADAS do vault — obra aposentada (scripts/arquivar_obra.py), átomos
# consolidados e backups de passada. São o MESMO material do vault, só que fora
# dele: se o vault não é versionado, a cópia dele também não pode ser (um
# `git add -A` distraído mandou 24.426 notas para o índice em 2026-07-28).
dados/arquivo_obras/
dados/aposentados/
dados/backups/
dados/_arquivo_consolidacao/

# Índice derivado (Chroma) + SQLite + dump — regenerados em runtime
dados/banco_vetorial_cerebro/
# Índice de uma base ARQUIVADA, montado só para comparar duas versões do vault
# (teste cego de 2026-07-28). Derivado como qualquer outro Chroma.
dados/banco_temp_teste_cego/
dados/banco_vetorial_cerebro.bak_l2/
dados/banco_vetorial_cerebro.corrompido/
dados/telemetria_etl.db
dados/telemetria_etl.db-wal
dados/telemetria_etl.db-shm
dados/chat_dump_bruto.md
# Listas geradas para o dono amostrar (pares de paráfrase, átomos truncados…):
# são SAÍDA de varredura, refeitas pelo script quando preciso — não fonte.
dados/*.md

# Traces de latência (padrão de uso com timestamps) e amostras de voz — a pasta de
# vozes pode conter a VOZ CLONADA do dono (biometria) quando o speaker_wav do XTTS
# apontar para gravação própria. Nunca num repo público (painel 2026-07-24).
dados/traces/
dados/amostras_vozes/
dados/amostra_*.wav

# Fila de ingestão de livros (Fase 1): os jobs carregam o TEXTO INTEGRAL dos
# livros do dono — conteúdo pessoal e possivelmente com direitos autorais.
dados/ingestao/

# Arquivo morto da consolidação (Fase 2): originais fundidos, preservados p/
# reversão — conteúdo do vault do dono, nunca versionado.
dados/_arquivo_consolidacao/

# Quarentena da precedência entre obras: notas SAÍDAS do vault quando uma edição
# preferida superou a antiga. É conteúdo de livro, preservado só para reversão —
# mesma razão do arquivo morto acima.
dados/aposentados/

# Pasta vigiada de livros: os PDFs do dono (pessoais e com direitos autorais).
dados/livros/

# Saídas do A/B de modelos: carregam perguntas reais e trechos do VAULT (mesma regra
# do Cerebro_Digital acima). São regeneráveis com `ab_modelos.py --preparar`, então
# versiona-se a ferramenta, não o dado do usuário.
eval/casos.json
eval/resultado_*.json

# Estado/log do import de histórico (retomável, específico da máquina)
scripts/importar_gemini.estado.json
scripts/import.log

# Saidas do teste ponta a ponta da resposta: mesma regra do ab_modelos acima —
# carregam perguntas reais e respostas aterradas no VAULT. Regeneraveis com
# `resposta_e2e.py`, entao versiona-se a ferramenta, nao o dado do usuario.
eval/saidas/

# Amostras de calibração da prosódia do TTS: binários WAV, regeneráveis com
# eval/amostras_tts.py — versiona-se a ferramenta, não o áudio.
eval/amostras_tts_out/

# Backups locais: pré-expurgo do DB + backup do limpar_vault.py (_lixo_purgado).
# Nunca versionar. `backups/` cobre a pasta de arquivamento; `_lixo_purgado/`
# (depth-agnostic) cobre o backup que o limpar_vault.py cria em dados/ — FORA do
# vault, senão o sync recursivo o re-indexaria.
backups/
_lixo_purgado/

# Grafo do Graphify: ~220 MB (cache + backups datados), GERADO localmente com
# `graphify update .`. Versiona-se a ferramenta e as regras no CLAUDE.md, não a saída.
graphify-out/

# Artefato do pytest-cov local
.coverage

# Saidas do recorte de figuras (Fase 5c): relatorios de deteccao, folhas de
# auditoria e o resultado da emulacao. Sao DADOS gerados (o de producao soma
# ~4 MB), regeneraveis pelos scripts de eval/ — ficam no disco, fora do git.
eval/relatorios/
eval/auditoria/
eval/emulacao_figuras.json
eval/spike/
